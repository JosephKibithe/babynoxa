# Copy to .env.amoy.local, keep that file mode 600, and never commit it.
AMOY_RPC_URL=https://polygon-amoy.drpc.org
PRIVATE_KEY=0xREPLACE_WITH_A_DEDICATED_AMOY_TESTNET_KEY
BABYNOXA_TREASURY=0xREPLACE_WITH_THE_AMOY_TREASURY_ADDRESS

# Public-testnet-only path used when no authoritative canonical Amoy WPOL is available.
# The deployment artifact records testWrappedNative=true. Never use this on mainnet.
DEPLOY_TEST_WRAPPED_NATIVE=true

# Optional. Initial owner must equal the deployer when provided.
# BABYNOXA_OWNER=0xREPLACE_WITH_THE_DEPLOYER_ADDRESS

# Optional, only needed for PolygonScan verification.
# POLYGONSCAN_API_KEY=
