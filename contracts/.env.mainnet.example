# Copy to .env.mainnet.local, chmod it to 600, and never commit or paste its key.
POLYGON_MAINNET_RPC_URL=https://polygon.drpc.org
PRIVATE_KEY=0xREPLACE_WITH_A_DEDICATED_POLYGON_MAINNET_KEY

# This exact value is required because the candidate has not completed its audit,
# Amoy rehearsal, or production approval. The deployment artifact remains stamped
# UNAPPROVED_MAINNET_TEST.
MAINNET_TEST_ACK=I_ACKNOWLEDGE_UNAUDITED_MAINNET_TEST

# Optional. Both default to the deployer when omitted. Initial owner must equal deployer.
# BABYNOXA_TREASURY=0xREPLACE_WITH_THE_MAINNET_TREASURY_ADDRESS
# BABYNOXA_OWNER=0xREPLACE_WITH_THE_DEPLOYER_ADDRESS

# Canonical WPOL is pinned in the deployment script. Do not configure
# DEPLOY_TEST_WRAPPED_NATIVE or WRAPPED_NATIVE for Polygon mainnet.

# Polygon mainnet graduates onto the canonical QuickSwap V2 AMM (stock Uniswap V2) so
# graduated tokens are discoverable on QuickSwap and DexScreener. Both default to the
# canonical QuickSwap V2 deployment; override only for a private/fork rehearsal.
# QUICKSWAP_V2_FACTORY=0x5757371414417b8C6CAad45bAeF941aBc7d3Ab32
# QUICKSWAP_V2_ROUTER=0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff

# Optional, only needed for PolygonScan verification.
# POLYGONSCAN_API_KEY=
