{
  "files.exclude": {
    "contracts/lib/openzeppelin-contracts/.github": true,
    "contracts/lib/openzeppelin-contracts/certora": true,
    "contracts/lib/openzeppelin-contracts/lib": true,
    "contracts/lib/openzeppelin-contracts/test": true
  },
  "search.exclude": {
    "contracts/lib/openzeppelin-contracts/.github": true,
    "contracts/lib/openzeppelin-contracts/certora": true,
    "contracts/lib/openzeppelin-contracts/lib": true,
    "contracts/lib/openzeppelin-contracts/test": true
  },
  "files.watcherExclude": {
    "**/contracts/lib/openzeppelin-contracts/.github/**": true,
    "**/contracts/lib/openzeppelin-contracts/certora/**": true,
    "**/contracts/lib/openzeppelin-contracts/lib/**": true,
    "**/contracts/lib/openzeppelin-contracts/test/**": true
  },
  "files.associations": {
    "contracts/lib/openzeppelin-contracts/.github/workflows/*.yml": "plaintext",
    "contracts/lib/openzeppelin-contracts/.github/workflows/*.yaml": "plaintext",
    "contracts/lib/openzeppelin-contracts/certora/**/*.sol": "plaintext",
    "contracts/lib/openzeppelin-contracts/test/**/*.sol": "plaintext"
  },
  "wake.compiler.solc.remappings": [
    "@openzeppelin/contracts/=contracts/lib/openzeppelin-contracts/contracts/",
    "@uniswap/lib/=contracts/lib/uniswap-lib/",
    "@uniswap/v2-core/=contracts/lib/uniswap-v2-core/",
    "@uniswap/v2-periphery/=contracts/lib/uniswap-v2-periphery/",
    "forge-std/=contracts/lib/forge-std/src/"
  ],
  "solidity.remappings": [
    "@openzeppelin/contracts/=contracts/lib/openzeppelin-contracts/contracts/",
    "@uniswap/lib/=contracts/lib/uniswap-lib/",
    "@uniswap/v2-core/=contracts/lib/uniswap-v2-core/",
    "@uniswap/v2-periphery/=contracts/lib/uniswap-v2-periphery/",
    "forge-std/=contracts/lib/forge-std/src/"
  ]
}
