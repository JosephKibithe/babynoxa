VITE_API_URL=http://127.0.0.1:3000
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545

# Public builds keep the internal moderation dashboard disabled.
VITE_ENABLE_ADMIN_DASHBOARD=false

# Enable Polygon Amoy only after Phase 10 deployment artifacts are verified.
VITE_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
VITE_AMOY_FACTORY=
VITE_AMOY_ROUTER=
VITE_AMOY_WRAPPED_NATIVE=
VITE_AMOY_MANAGER=

# Explicit unapproved Polygon mainnet test deployment. Keep unset in normal builds.
# On mainnet, launches graduate onto QuickSwap V2, so the router is QuickSwap's canonical
# V2 router (0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff). Factory/manager come from the
# BabyNoxaFactoryQS + GraduationManagerV2 deployment artifact.
VITE_POLYGON_MAINNET_RPC_URL=https://polygon.gateway.tenderly.co
VITE_POLYGON_MAINNET_FACTORY=
VITE_POLYGON_MAINNET_ROUTER=0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff
VITE_POLYGON_MAINNET_WRAPPED_NATIVE=0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270
VITE_POLYGON_MAINNET_MANAGER=
